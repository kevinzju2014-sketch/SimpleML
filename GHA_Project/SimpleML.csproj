<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>SimpleML</RootNamespace>
    <AssemblyName>SimpleML</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\Release\</OutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <!-- 可通过 /p:RhinoSystemDir=... 覆盖 Rhino 安装路径 -->
    <RhinoSystemDir Condition="'$(RhinoSystemDir)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">C:\Program Files\Rhino 8\System</RhinoSystemDir>
    <RhinoGrasshopperDir Condition="'$(RhinoGrasshopperDir)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">C:\Program Files\Rhino 8\Plug-ins\Grasshopper</RhinoGrasshopperDir>
    <RhinoSystemDir Condition="'$(RhinoSystemDir)' == '' and !$([MSBuild]::IsOSPlatform('Windows'))">/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/A/Resources</RhinoSystemDir>
    <RhinoGrasshopperDir Condition="'$(RhinoGrasshopperDir)' == '' and !$([MSBuild]::IsOSPlatform('Windows'))">/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/A/Resources/Plug-ins/Grasshopper</RhinoGrasshopperDir>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Grasshopper">
      <HintPath>$(RhinoGrasshopperDir)\Grasshopper.dll</HintPath>
      <HintPath Condition="Exists('$(RhinoGrasshopperDir)/Grasshopper.dll')">$(RhinoGrasshopperDir)/Grasshopper.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GH_IO">
      <HintPath>$(RhinoGrasshopperDir)\GH_IO.dll</HintPath>
      <HintPath Condition="Exists('$(RhinoGrasshopperDir)/GH_IO.dll')">$(RhinoGrasshopperDir)/GH_IO.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoSystemDir)\RhinoCommon.dll</HintPath>
      <HintPath Condition="Exists('$(RhinoSystemDir)/RhinoCommon.dll')">$(RhinoSystemDir)/RhinoCommon.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\**\*.py" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="icons\*.png" />
  </ItemGroup>

  <Target Name="CreateGHA" AfterTargets="Build" Condition="'$(TargetPath)' != ''">
    <PropertyGroup>
      <GhaFilePath>$(TargetDir)$(AssemblyName).gha</GhaFilePath>
    </PropertyGroup>
    <Error Condition="!Exists('$(TargetPath)')" Text="错误: 找不到构建输出文件 $(TargetPath)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(GhaFilePath)"
          SkipUnchangedFiles="false"
          ContinueOnError="false" />
    <Error Condition="!Exists('$(GhaFilePath)')" Text="错误: GHA文件创建失败: $(GhaFilePath)" />
    <Message Text="GHA文件已成功创建: $(GhaFilePath)" Importance="high" />
  </Target>

</Project>
